# Local development defaults. Never commit real secrets.
# Copy this file to .env before changing any value.

# Published ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL container and native backend development
POSTGRES_DB=befocus
POSTGRES_USER=befocus
POSTGRES_PASSWORD=befocus_dev
DB_URL=jdbc:postgresql://localhost:5432/befocus
DB_USERNAME=befocus
DB_PASSWORD=befocus_dev

# Production platforms may instead provide a postgres:// or postgresql:// URL.
# DB_URL takes precedence when both variables are present.
# DATABASE_URL=

# Generate a unique secret of at least 32 random bytes for every deployment.
JWT_SECRET=dev-only-change-me-befocus-32-bytes-minimum
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600

# Comma-separated browser origins. The Docker frontend proxies /api same-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=UTC
SEED_ENABLED=false

# Browser API base. Keep /api/v1 when using the production Nginx container.
VITE_API_URL=/api/v1
BACKEND_HOSTPORT=backend:8080
